        <activity android:name=".HomeActivity" android:exported="false" />
        <activity android:name=".SelectLocationActivity" android:exported="false" />
        <activity android:name=".PointsListActivity" android:exported="false" />
        <activity android:name=".PointDetailActivity" android:exported="false" />
