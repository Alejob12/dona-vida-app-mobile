<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema base de la aplicación -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:textColorPrimary">@color/colorTextPrimary</item>
    </style>

    <!-- Estilos de texto -->
    <style name="TextAppearance.DonaVida.Title" parent="TextAppearance.AppCompat">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
    </style>

    <style name="TextAppearance.DonaVida.Subtitle" parent="TextAppearance.AppCompat">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
    </style>

    <style name="TextAppearance.DonaVida.Body" parent="TextAppearance.AppCompat">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
    </style>

    <style name="TextAppearance.DonaVida.BodySecondary" parent="TextAppearance.AppCompat">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/colorTextSecondary</item>
    </style>

    <style name="TextAppearance.DonaVida.Caption" parent="TextAppearance.AppCompat">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/colorTextSecondary</item>
    </style>

    <style name="TextAppearance.DonaVida.ButtonLabel" parent="TextAppearance.AppCompat">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Botones (MaterialButton: el tema MaterialComponents infla todo <Button> como
         com.google.android.material.button.MaterialButton, que ignora android:background
         y dibuja su propio fondo vía backgroundTint/strokeColor/cornerRadius) -->
    <style name="Widget.DonaVida.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="cornerRadius">@dimen/radius_default</item>
        <item name="android:textAppearance">@style/TextAppearance.DonaVida.ButtonLabel</item>
        <item name="android:textColor">@color/colorWhite</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:minWidth">@dimen/field_min_width</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="elevation">@dimen/elevation_button</item>
        <item name="android:paddingStart">@dimen/spacing_md</item>
        <item name="android:paddingEnd">@dimen/spacing_md</item>
    </style>

    <style name="Widget.DonaVida.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/colorBorder</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@color/colorSurface</item>
        <item name="cornerRadius">@dimen/radius_default</item>
        <item name="android:textAppearance">@style/TextAppearance.DonaVida.ButtonLabel</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:minWidth">@dimen/field_min_width</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="elevation">0dp</item>
        <item name="android:paddingStart">@dimen/spacing_md</item>
        <item name="android:paddingEnd">@dimen/spacing_md</item>
    </style>

    <style name="Widget.DonaVida.Button.Borderless" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textAppearance">@style/TextAppearance.DonaVida.ButtonLabel</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:paddingStart">@dimen/spacing_xs</item>
        <item name="android:paddingEnd">@dimen/spacing_xs</item>
    </style>

    <!-- Campos de texto -->
    <style name="Widget.DonaVida.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/colorBorder</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_default</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_default</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_default</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_default</item>
        <item name="hintTextColor">@color/colorTextSecondary</item>
        <item name="android:textColorHint">@color/colorTextSecondary</item>
        <item name="android:minHeight">@dimen/input_field_min_height</item>
    </style>

    <!-- Tarjetas -->
    <style name="Widget.DonaVida.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/radius_default</item>
        <item name="cardElevation">@dimen/elevation_card</item>
        <item name="cardBackgroundColor">@color/colorSurface</item>
        <item name="contentPadding">@dimen/spacing_md</item>
    </style>

    <!-- Calendario -->
    <style name="DonaVida.Calendar.WeekdayLabel" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">@style/TextAppearance.DonaVida.Caption</item>
    </style>

    <!-- Nota informativa / banner -->
    <style name="Widget.DonaVida.Banner" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/radius_small</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/colorBannerBackground</item>
        <item name="contentPadding">@dimen/spacing_md</item>
        <item name="strokeColor">@color/colorBorder</item>
        <item name="strokeWidth">1dp</item>
    </style>

</resources>
