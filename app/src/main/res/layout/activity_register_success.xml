<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_brand_pattern"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/superior"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xxl"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <FrameLayout
            android:id="@+id/brandIconContainer"
            android:layout_width="@dimen/brand_image_size"
            android:layout_height="@dimen/brand_image_size"
            android:background="@drawable/bg_icon_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_icon_check_circle"
                android:src="@drawable/ic_check_circle"
                android:tint="@color/colorPrimary" />
        </FrameLayout>

        <TextView
            android:id="@+id/registerSuccessTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:gravity="center"
            android:text="@string/registerSuccess_title"
            android:textAppearance="@style/TextAppearance.DonaVida.Title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/brandIconContainer" />

        <TextView
            android:id="@+id/registerSuccessSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/spacing_md"
            android:gravity="center"
            android:text="@string/registerSuccess_subtitle"
            android:textAppearance="@style/TextAppearance.DonaVida.Body"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/registerSuccessTitle" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/superior">

        <LinearLayout
            android:id="@+id/inferior"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_lg">

            <include
                android:id="@+id/confirmationBanner"
                layout="@layout/partial_banner_confirmation" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="3dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:background="@drawable/bg_section_marker" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/registerSuccess_section_title"
                    android:textAppearance="@style/TextAppearance.DonaVida.Subtitle" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/verifyEligibilityItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="@dimen/radius_large"
                app:cardElevation="@dimen/elevation_card"
                app:cardBackgroundColor="@color/colorSurface">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/list_item_min_height">

                    <FrameLayout
                        android:id="@+id/item1IconContainer"
                        android:layout_width="@dimen/icon_container_size"
                        android:layout_height="@dimen/icon_container_size"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:background="@drawable/bg_icon_container"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:layout_width="@dimen/icon_size_default"
                            android:layout_height="@dimen/icon_size_default"
                            android:layout_gravity="center"
                            android:contentDescription="@string/cd_icon_check_circle"
                            android:src="@drawable/ic_check_circle"
                            android:tint="@color/colorPrimary" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/item1Title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:text="@string/registerSuccess_item1_title"
                        android:textAppearance="@style/TextAppearance.DonaVida.Body"
                        app:layout_constraintEnd_toStartOf="@id/item1Chevron"
                        app:layout_constraintStart_toEndOf="@id/item1IconContainer"
                        app:layout_constraintTop_toTopOf="@id/item1IconContainer" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/registerSuccess_item1_subtitle"
                        android:textAppearance="@style/TextAppearance.DonaVida.Caption"
                        app:layout_constraintEnd_toStartOf="@id/item1Chevron"
                        app:layout_constraintStart_toStartOf="@id/item1Title"
                        app:layout_constraintTop_toBottomOf="@id/item1Title" />

                    <ImageView
                        android:id="@+id/item1Chevron"
                        android:layout_width="@dimen/icon_size_small"
                        android:layout_height="@dimen/icon_size_small"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="@color/colorTextSecondary"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/findPointItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="@dimen/radius_large"
                app:cardElevation="@dimen/elevation_card"
                app:cardBackgroundColor="@color/colorSurface">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/list_item_min_height">

                    <FrameLayout
                        android:id="@+id/item2IconContainer"
                        android:layout_width="@dimen/icon_container_size"
                        android:layout_height="@dimen/icon_container_size"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:background="@drawable/bg_icon_container"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:layout_width="@dimen/icon_size_default"
                            android:layout_height="@dimen/icon_size_default"
                            android:layout_gravity="center"
                            android:contentDescription="@string/cd_icon_location"
                            android:src="@drawable/ic_place"
                            android:tint="@color/colorPrimary" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/item2Title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:text="@string/registerSuccess_item2_title"
                        android:textAppearance="@style/TextAppearance.DonaVida.Body"
                        app:layout_constraintEnd_toStartOf="@id/item2Chevron"
                        app:layout_constraintStart_toEndOf="@id/item2IconContainer"
                        app:layout_constraintTop_toTopOf="@id/item2IconContainer" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/registerSuccess_item2_subtitle"
                        android:textAppearance="@style/TextAppearance.DonaVida.Caption"
                        app:layout_constraintEnd_toStartOf="@id/item2Chevron"
                        app:layout_constraintStart_toStartOf="@id/item2Title"
                        app:layout_constraintTop_toBottomOf="@id/item2Title" />

                    <ImageView
                        android:id="@+id/item2Chevron"
                        android:layout_width="@dimen/icon_size_small"
                        android:layout_height="@dimen/icon_size_small"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="@color/colorTextSecondary"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/goHomeButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/registerSuccess_home_button"
                style="@style/Widget.DonaVida.Button.Primary" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
