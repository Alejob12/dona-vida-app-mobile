<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_brand_pattern"
    android:fitsSystemWindows="true">

    <include
        android:id="@+id/topAppBar"
        layout="@layout/partial_top_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/bottomTabBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topAppBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_lg">

            <TextView
                android:id="@+id/homeGreeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_greeting"
                android:textAppearance="@style/TextAppearance.DonaVida.Subtitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/home_subtitle"
                android:textAppearance="@style/TextAppearance.DonaVida.Body" />

            <include
                android:id="@+id/nextAppointmentHeader"
                layout="@layout/partial_section_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md" />

            <include
                android:id="@+id/nextAppointmentItem"
                layout="@layout/partial_list_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs" />

            <include
                android:id="@+id/reminderNote"
                layout="@layout/partial_info_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs" />

            <include
                android:id="@+id/quickActionsHeader"
                layout="@layout/partial_section_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md" />

            <include
                android:id="@+id/actionDonateItem"
                layout="@layout/partial_list_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm" />

            <include
                android:id="@+id/actionAppointmentItem"
                layout="@layout/partial_list_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm" />

            <include
                android:id="@+id/actionEligibilityItem"
                layout="@layout/partial_list_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm" />

            <include
                android:id="@+id/actionProfileItem"
                layout="@layout/partial_list_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm" />

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomTabBar"
        layout="@layout/partial_bottom_tab_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
