<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_brand_pattern"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/superior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/topAppBar"
            layout="@layout/partial_top_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/avatarCircle"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/bg_avatar_circle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topAppBar" />

        <TextView
            android:id="@+id/avatarInitials"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:text="@string/personalData_avatar_initials"
            android:textAppearance="@style/TextAppearance.DonaVida.Subtitle"
            android:textColor="@color/colorPrimary"
            android:textSize="24sp"
            app:layout_constraintBottom_toBottomOf="@id/avatarCircle"
            app:layout_constraintEnd_toEndOf="@id/avatarCircle"
            app:layout_constraintStart_toStartOf="@id/avatarCircle"
            app:layout_constraintTop_toTopOf="@id/avatarCircle" />

        <TextView
            android:id="@+id/userNameLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_marginEnd="@dimen/spacing_md"
            android:text="@string/personalData_user_name"
            android:textAppearance="@style/TextAppearance.DonaVida.Subtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/avatarCircle"
            app:layout_constraintTop_toTopOf="@id/avatarCircle" />

        <TextView
            android:id="@+id/userSinceLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/personalData_user_since"
            android:textAppearance="@style/TextAppearance.DonaVida.Caption"
            android:textColor="@color/colorTextPrimary"
            app:layout_constraintEnd_toEndOf="@id/userNameLabel"
            app:layout_constraintStart_toStartOf="@id/userNameLabel"
            app:layout_constraintTop_toBottomOf="@id/userNameLabel" />

        <TextView
            android:id="@+id/userStatsLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/personalData_user_stats"
            android:textAppearance="@style/TextAppearance.DonaVida.Caption"
            android:textColor="@color/colorTextPrimary"
            app:layout_constraintEnd_toEndOf="@id/userNameLabel"
            app:layout_constraintStart_toStartOf="@id/userNameLabel"
            app:layout_constraintTop_toBottomOf="@id/userSinceLabel" />

        <View
            android:id="@+id/avatarSpacer"
            android:layout_width="1dp"
            android:layout_height="@dimen/spacing_sm"
            app:layout_constraintTop_toBottomOf="@id/avatarCircle" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/bottomTabBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/superior">

        <LinearLayout
            android:id="@+id/inferior"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_note_informativa"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_sm">

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:background="@drawable/bg_accent_bar_note" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:contentDescription="@string/cd_icon_info"
                    android:src="@drawable/ic_info"
                    android:tint="@color/colorPrimary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/personalData_note"
                    android:textAppearance="@style/TextAppearance.DonaVida.Body" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_sm" />

            <include
                android:id="@+id/personalDataSectionHeader"
                layout="@layout/partial_section_header" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_xs" />

            <include
                android:id="@+id/itemName"
                layout="@layout/partial_list_item" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_xxs" />

            <include
                android:id="@+id/itemEmail"
                layout="@layout/partial_list_item" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_xxs" />

            <include
                android:id="@+id/itemPhone"
                layout="@layout/partial_list_item" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_xxs" />

            <include
                android:id="@+id/itemBloodType"
                layout="@layout/partial_list_item" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_xxs" />

            <include
                android:id="@+id/itemCity"
                layout="@layout/partial_list_item" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_md" />

            <Button
                android:id="@+id/editProfileButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/personalData_edit_button"
                style="@style/Widget.DonaVida.Button.Primary" />

            <Button
                android:id="@+id/logoutButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxs"
                app:strokeColor="@color/colorTextSecondary"
                app:strokeWidth="1.5dp"
                android:text="@string/personalData_logout_button"
                style="@style/Widget.DonaVida.Button.Secondary" />

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomTabBar"
        layout="@layout/partial_bottom_tab_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
