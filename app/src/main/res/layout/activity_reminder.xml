<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_brand_pattern"
    android:fitsSystemWindows="true">

    <include
        android:id="@+id/topAppBar"
        layout="@layout/partial_top_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topAppBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_lg">

            <include
                android:id="@+id/banner"
                layout="@layout/partial_banner_confirmation" />

            <include
                android:id="@+id/sectionPreferences"
                layout="@layout/partial_section_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md" />

            <CheckBox
                android:id="@+id/checkAppNotification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:buttonTint="@color/colorPrimary"
                android:checked="false"
                android:text="@string/reminder_check_app"
                android:textAppearance="@style/TextAppearance.DonaVida.Body" />

            <CheckBox
                android:id="@+id/checkEmailNotification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxs"
                android:buttonTint="@color/colorPrimary"
                android:checked="true"
                android:text="@string/reminder_check_email"
                android:textAppearance="@style/TextAppearance.DonaVida.Body" />

            <CheckBox
                android:id="@+id/checkSmsNotification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxs"
                android:buttonTint="@color/colorPrimary"
                android:checked="false"
                android:text="@string/reminder_check_sms"
                android:textAppearance="@style/TextAppearance.DonaVida.Body" />

            <include
                android:id="@+id/note"
                layout="@layout/partial_info_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md" />

            <Button
                android:id="@+id/homeButton"
                style="@style/Widget.DonaVida.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/reminder_home_button" />

            <Button
                android:id="@+id/viewEligibilityButton"
                style="@style/Widget.DonaVida.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/reminder_view_eligibility_button" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
