<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_brand_pattern"
    android:fitsSystemWindows="true">

    <include
        android:id="@+id/topAppBar"
        layout="@layout/partial_top_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topAppBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_lg">

            <TextView
                android:id="@+id/currentAppointmentText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rescheduleAppointment_current_appointment"
                android:textAppearance="@style/TextAppearance.DonaVida.Body" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@color/colorIconSoftFill" />

            <include
                android:id="@+id/sectionNewDate"
                layout="@layout/partial_section_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm" />

            <RadioGroup
                android:id="@+id/newDateRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/dateOption1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:buttonTint="@color/colorPrimary"
                    android:checked="true"
                    android:text="@string/rescheduleAppointment_date_option1"
                    android:textAppearance="@style/TextAppearance.DonaVida.Body" />

                <RadioButton
                    android:id="@+id/dateOption2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:buttonTint="@color/colorPrimary"
                    android:text="@string/rescheduleAppointment_date_option2"
                    android:textAppearance="@style/TextAppearance.DonaVida.Body" />

                <RadioButton
                    android:id="@+id/dateOption3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:buttonTint="@color/colorPrimary"
                    android:text="@string/rescheduleAppointment_date_option3"
                    android:textAppearance="@style/TextAppearance.DonaVida.Body" />

            </RadioGroup>

            <include
                android:id="@+id/sectionNewTime"
                layout="@layout/partial_section_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md" />

            <RadioGroup
                android:id="@+id/newTimeRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/timeOption1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:buttonTint="@color/colorPrimary"
                    android:text="@string/rescheduleAppointment_time_option1"
                    android:textAppearance="@style/TextAppearance.DonaVida.Body" />

                <RadioButton
                    android:id="@+id/timeOption2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:buttonTint="@color/colorPrimary"
                    android:checked="true"
                    android:text="@string/rescheduleAppointment_time_option2"
                    android:textAppearance="@style/TextAppearance.DonaVida.Body" />

                <RadioButton
                    android:id="@+id/timeOption3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:buttonTint="@color/colorPrimary"
                    android:text="@string/rescheduleAppointment_time_option3"
                    android:textAppearance="@style/TextAppearance.DonaVida.Body" />

            </RadioGroup>

            <include
                android:id="@+id/note"
                layout="@layout/partial_info_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md" />

            <Button
                android:id="@+id/confirmRescheduleButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/rescheduleAppointment_confirm_button"
                style="@style/Widget.DonaVida.Button.Primary" />

            <Button
                android:id="@+id/backButton3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/rescheduleAppointment_back_button"
                style="@style/Widget.DonaVida.Button.Secondary" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
