<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/stepperLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.DonaVida.Body" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="@dimen/spacing_xs"
        android:orientation="horizontal">

        <View
            android:id="@+id/stepperSegment1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/spacing_xxs"
            android:layout_weight="1"
            android:background="@drawable/bg_stepper_filled" />

        <View
            android:id="@+id/stepperSegment2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/spacing_xxs"
            android:layout_weight="1"
            android:background="@drawable/bg_stepper_unfilled" />

        <View
            android:id="@+id/stepperSegment3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/spacing_xxs"
            android:layout_weight="1"
            android:background="@drawable/bg_stepper_unfilled" />

        <View
            android:id="@+id/stepperSegment4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_stepper_unfilled" />

    </LinearLayout>
</LinearLayout>
