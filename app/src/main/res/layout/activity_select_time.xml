<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_brand_pattern"
    android:fitsSystemWindows="true">

    <include
        android:id="@+id/topAppBar"
        layout="@layout/partial_top_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topAppBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_lg">

            <include
                android:id="@+id/stepper"
                layout="@layout/partial_stepper_progress" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/selectTime_title"
                android:textAppearance="@style/TextAppearance.DonaVida.Subtitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxs"
                android:text="@string/selectTime_subtitle"
                android:textAppearance="@style/TextAppearance.DonaVida.Body" />

            <include
                android:id="@+id/sectionMorning"
                layout="@layout/partial_section_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md" />

            <RadioGroup
                android:id="@+id/timeOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/timeOptionMorning1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/colorPrimary"
                    android:minHeight="@dimen/button_min_height"
                    android:text="@string/selectTime_option_morning1"
                    android:textAppearance="@style/TextAppearance.DonaVida.Body" />

                <RadioButton
                    android:id="@+id/timeOptionMorning2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/colorPrimary"
                    android:minHeight="@dimen/button_min_height"
                    android:text="@string/selectTime_option_morning2"
                    android:textAppearance="@style/TextAppearance.DonaVida.Body" />

                <RadioButton
                    android:id="@+id/timeOptionMorning3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/colorPrimary"
                    android:minHeight="@dimen/button_min_height"
                    android:text="@string/selectTime_option_morning3"
                    android:textAppearance="@style/TextAppearance.DonaVida.Body" />

                <include
                    android:id="@+id/sectionAfternoon"
                    layout="@layout/partial_section_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md" />

                <RadioButton
                    android:id="@+id/timeOptionAfternoon1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:buttonTint="@color/colorPrimary"
                    android:minHeight="@dimen/button_min_height"
                    android:text="@string/selectTime_option_afternoon1"
                    android:textAppearance="@style/TextAppearance.DonaVida.Body" />

            </RadioGroup>

            <LinearLayout
                android:id="@+id/timeOptionAfternoon2Row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="@dimen/button_min_height"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <RadioButton
                    android:id="@+id/timeOptionAfternoon2Radio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:enabled="false"
                    android:focusable="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xxs"
                    android:alpha="0.5"
                    android:text="@string/selectTime_option_afternoon2_unavailable"
                    android:textAppearance="@style/TextAppearance.DonaVida.Body" />

            </LinearLayout>

            <include
                android:id="@+id/note"
                layout="@layout/partial_info_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md" />

            <Button
                android:id="@+id/confirmButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/selectTime_confirm_button"
                style="@style/Widget.DonaVida.Button.Primary" />

            <Button
                android:id="@+id/changeDateButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/selectTime_change_date_button"
                style="@style/Widget.DonaVida.Button.Secondary" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
